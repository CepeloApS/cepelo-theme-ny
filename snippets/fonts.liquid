{%- comment -%}
  Fonte hostet i assets/ (Shopify CDN), så der ikke hentes noget fra Google ved sideindlæsning.
  Montserrat 800 (overskrifter) og Open Sans 300/400/600 (brødtekst). Latin-subset dækker æ, ø og å.
  Licens: SIL Open Font License 1.1 (via Fontsource).
{%- endcomment -%}
{{ 'montserrat-latin-800-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'open-sans-latin-400-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
<style>
  @font-face {
    font-family: 'Montserrat';
    font-style: normal;
    font-weight: 800;
    font-display: swap;
    src: url('{{ 'montserrat-latin-800-normal.woff2' | asset_url }}') format('woff2');
  }
  @font-face {
    font-family: 'Open Sans';
    font-style: normal;
    font-weight: 300;
    font-display: swap;
    src: url('{{ 'open-sans-latin-300-normal.woff2' | asset_url }}') format('woff2');
  }
  @font-face {
    font-family: 'Open Sans';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'open-sans-latin-400-normal.woff2' | asset_url }}') format('woff2');
  }
  @font-face {
    font-family: 'Open Sans';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url('{{ 'open-sans-latin-600-normal.woff2' | asset_url }}') format('woff2');
  }
</style>
