<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#FFFFFF">

    <title>
      {{- page_title -}}
      {%- if current_tags -%}
        {%- assign tag_list = current_tags | join: ', ' %} – {{ 'general.meta.tags' | t: tags: tag_list }}
      {%- endif -%}
      {%- if current_page != 1 %} – {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    <link rel="canonical" href="{{ canonical_url }}">

    {% render 'fonts' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {%- comment -%} Header-section group tilføjes i punkt 2 (header med mega-menu). {%- endcomment -%}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- comment -%} Footer-section group tilføjes i punkt 2. Structured data tilføjes i punkt 3. {%- endcomment -%}
  </body>
</html>
